# TEST-ONLY (milestones.md §6.9.2 item 23(d)). Three sites on ONE host name, all proxying the same demo process, so a
# single run covers the pass case and both paired negatives. {$VERIFIER_HOST} and {$WORK_DIR} come from the environment
# (run.sh sets them); no host name is written down here.
#
#   https://HOST        good      CA-valid cert (Let's Encrypt). Well-known serves the key that SIGNS the requests.
#   https://HOST:8444   mismatch  CA-valid cert. Well-known serves a DIFFERENT key (same kid), so the signature must fail.
#   https://HOST:8445   badcert   Cert issued by Caddy's own internal CA, which no phone trusts: TLS must be refused.

(site) {
	handle /.well-known/zkagent-verifier {
		root * {$WORK_DIR}/{args[0]}
		header Content-Type application/json
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:8787
	}
}

{$VERIFIER_HOST} {
	import site wk-good
}

{$VERIFIER_HOST}:8444 {
	import site wk-mismatch
}

{$VERIFIER_HOST}:8445 {
	tls internal
	import site wk-good
}
