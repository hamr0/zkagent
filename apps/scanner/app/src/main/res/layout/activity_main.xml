<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- §6.2 item 16 (D44) — "Scan" is the existing form+report screen,
         unchanged; "Log" is the additional per-scan report log view. Tab
         selection only toggles which of [main_layout]/[log_layout] is
         visible — see MainActivity.onTabSelected doc. -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.tabs.TabItem
            android:id="@+id/tab_scan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_scan" />

        <com.google.android.material.tabs.TabItem
            android:id="@+id/tab_log"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_log" />

    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="@dimen/activity_vertical_margin">

        <LinearLayout
            android:id="@+id/loading_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/info_loading" />

        </LinearLayout>

        <!-- FIX (Q47 / findings.md #17): focusableInTouchMode is required
             here, not optional. View.clearFocus() defaults refocus=true,
             which calls the root view's requestFocus() to find a new
             candidate; a ViewGroup's default descendant-focusability order
             (FOCUS_BEFORE_DESCENDANTS) tries the container itself before
             descending into children. Without this attribute, main_layout
             is not a valid candidate, so that search descends straight to
             input_passport_number — the only focusableInTouchMode="true"
             EditText on the form — and re-focuses it immediately, silently
             undoing MainActivity's clearFocus() call. Setting this here
             gives the search a legitimate, harmless landing spot before it
             ever reaches the EditText (focusableInTouchMode="true" also
             implies android:focusable="true" per View's own XML parsing). -->
        <ScrollView
            android:id="@+id/main_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="@dimen/activity_horizontal_margin"
                android:paddingRight="@dimen/activity_horizontal_margin"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:layout_marginBottom="@dimen/activity_vertical_margin"
                    android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                    android:text="@string/info_scan_passport" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_passport_number_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_passport_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        android:hint="@string/input_passport_number" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_expiration_date_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_expiration_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/input_expiration_date"
                        android:inputType="date"
                        android:focusableInTouchMode="false" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_date_of_birth_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:layout_marginBottom="@dimen/activity_vertical_margin">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_date_of_birth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/input_date_of_birth"
                        android:inputType="date"
                        android:focusableInTouchMode="false" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- §6.2 item 4 (2026-09 real-device change, "remove the mode
                     radio entirely") — mode is DERIVED, never a user choice: a
                     verified handoff's tier sets it (D33/D34); a bare local scan
                     with no verified request is mode A by definition. This
                     TextView is the ONLY place mode is ever displayed — there is
                     no control here to disagree with the executed mode (F5's bug
                     class is eliminated by construction) — see MainActivity
                     class doc / MainActivity.refreshSessionDisplay / lockModeAndArm
                     (D58 step 4 renamed refreshModeStatus). -->
                <TextView
                    android:id="@+id/mode_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textStyle="italic"
                    tools:text="Locked: mode B — tap your document now" />

                <Button
                    android:id="@+id/button_lock_and_scan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:layout_marginBottom="@dimen/activity_vertical_margin"
                    android:text="@string/button_lock_and_scan" />

                <Button
                    android:id="@+id/button_m2_masterlist_probe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/activity_vertical_margin"
                    android:text="@string/button_masterlist_probe" />

                <!-- Debug-only, zero-tap: exercises DeviceKey.ensureKey's
                     generate -> reuse path (twice, same process) without an
                     NFC session — see MainActivity's DeviceKey self-test
                     root-cause note. -->
                <Button
                    android:id="@+id/button_devicekey_probe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/activity_vertical_margin"
                    android:text="@string/button_devicekey_probe" />

                <!-- §6.2 item 8 — handoff. Primary path is av:// + direct_post
                     (handled by RegularActivity's VIEW intent-filter, no UI of
                     its own needed — see MainActivity.pendingHandoff). This
                     block is ONLY the cross-device fallback: a verifier
                     website shows a QR on another screen; "Scan QR" launches
                     a live camera barcode scan (Google Code Scanner API,
                     finding #18 fix / D68 part b — see MainActivity.kt's
                     qrScanner/launchQrScan and README.md), and feeds the
                     decoded text into the SAME pendingHandoff capture path as
                     the av:// deep link. A manual-paste field is the
                     fallback-of-the-fallback. -->
                <LinearLayout
                    android:id="@+id/handoff_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/activity_vertical_margin"
                        android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                        android:text="@string/handoff_heading" />

                    <Button
                        android:id="@+id/button_scan_qr"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/button_scan_qr" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/handoff_manual_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/handoff_manual_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/handoff_manual_hint" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/handoff_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:textIsSelectable="true"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Value-free verdict/report screen (§6.2 item 5): verdict,
                     step names, counts, hashes, timings, algorithm names only.
                     Never a DG1/MRZ/personal field. Safe to screenshot. -->
                <TextView
                    android:id="@+id/report_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:layout_marginBottom="@dimen/activity_vertical_margin"
                    android:fontFamily="monospace"
                    android:textIsSelectable="true"
                    android:textSize="12sp"
                    android:text="" />

            </LinearLayout>

        </ScrollView>

        <!-- §6.2 item 16 (D44) — the log tab: an additional CONSUMER of the
             same value-free content emitReport() already writes to
             report_view (MainActivity.emitReport), never a second write
             site. Hidden unless the "Log" tab is selected. Same value-free
             invariant as report_view — safe to screenshot. -->
        <ScrollView
            android:id="@+id/log_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <TextView
                android:id="@+id/log_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="@dimen/activity_horizontal_margin"
                android:paddingRight="@dimen/activity_horizontal_margin"
                android:paddingTop="@dimen/activity_vertical_margin"
                android:paddingBottom="@dimen/activity_vertical_margin"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:textSize="12sp"
                android:text="" />

        </ScrollView>

        <FrameLayout
            android:id="@+id/bottom_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom" />

    </FrameLayout>

</LinearLayout>
