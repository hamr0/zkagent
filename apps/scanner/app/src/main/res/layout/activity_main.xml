<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- D115 (item 25) — the top bar (colorPrimaryDark #00796B so the white 15sp arrows reach 5.3:1) replaces the Toolbar and the TabLayout. A centred page title ("Scan", "Log" or
         "Settings"; MainActivity.showPane sets it from PaneState.pageTitle) with a tappable arrow either side naming
         the neighbour page (text from PaneState.previousArrowText / nextArrowText, hidden at an end page). The arrows
         are 48dp-high touch targets with spoken descriptions; the title is a polite live region and a heading so a
         page change is announced. -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:id="@+id/title_bar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorPrimaryDark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="4dp"
            android:paddingRight="4dp">

            <TextView
                android:id="@+id/nav_prev"
                android:layout_width="96dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical|start"
                android:paddingLeft="12dp"
                android:paddingRight="8dp"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                tools:text="‹ Log" />

            <TextView
                android:id="@+id/page_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Scan" />

            <TextView
                android:id="@+id/nav_next"
                android:layout_width="96dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical|end"
                android:paddingLeft="8dp"
                android:paddingRight="12dp"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                tools:text="Log ›" />

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- FIX (§6.2 item 24 device FAIL 2026-09-03): this pane container is 0dp + weight="1" so the footer below it
         (page dots, version stamp) is never pushed off screen. The pages are overlapping siblings; exactly one is
         visible, decided by PaneVisibility.choosePane and applied by MainActivity.showPane (the single writer,
         item 16). Swiping is detected by MainActivity.dispatchTouchEvent and routed to PaneState. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="@dimen/activity_vertical_margin">

        <LinearLayout
            android:id="@+id/loading_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/info_loading" />

        </LinearLayout>

        <!-- D115 — the Scan page, top to bottom: the site's question in a navy box, the hint line, the three
             document fields (always visible, outlined, floating labels, empty each scan; item 6), the paste block,
             a large VERIFY, the always-visible last-scan strip, About. No in-page heading. -->
        <ScrollView
            android:id="@+id/main_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true">

            <!-- FIX (Q47 / findings.md #17): focusableInTouchMode on the ScrollView is required, not optional:
                 View.clearFocus() re-focuses the first focusableInTouchMode EditText unless this container is a
                 valid landing spot for the root's focus search. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/activity_horizontal_margin"
                    android:paddingRight="@dimen/activity_horizontal_margin"
                    android:orientation="vertical">

                    <!-- The exact question from the signed request object, or D46's "Local scan (no site)" (see
                         MainActivity.applySessionDisplay / SessionDisplay.render's questionText). D115: white text on
                         the navy box (#0D2A4A), no light fill, no left bar. -->
                    <TextView
                        android:id="@+id/question_line"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/activity_vertical_margin"
                        android:background="@drawable/ask_box"
                        android:gravity="center"
                        android:minLines="1"
                        android:padding="12dp"
                        android:textColor="@color/ask_box_text"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="This website asks if you are over 18" />

                    <!-- The hint line (derived mode / "Ready — tap your document now" banner; MainActivity.refreshSessionDisplay is its
                         only writer). D115: directly under the question, above the fields and VERIFY. -->
                    <TextView
                        android:id="@+id/mode_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textStyle="italic"
                        tools:text="Ready — tap your document now" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/input_passport_number_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="6dp"
                        app:boxCornerRadiusTopEnd="6dp"
                        app:boxCornerRadiusBottomStart="6dp"
                        app:boxCornerRadiusBottomEnd="6dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_passport_number"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:hint="@string/input_passport_number"
                            android:inputType="textCapCharacters"
                            />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/input_expiration_date_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="6dp"
                        app:boxCornerRadiusTopEnd="6dp"
                        app:boxCornerRadiusBottomStart="6dp"
                        app:boxCornerRadiusBottomEnd="6dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_expiration_date"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:hint="@string/input_expiration_date"
                            android:inputType="date"
                            android:focusableInTouchMode="false"
                            />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/input_date_of_birth_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="6dp"
                        app:boxCornerRadiusTopEnd="6dp"
                        app:boxCornerRadiusBottomStart="6dp"
                        app:boxCornerRadiusBottomEnd="6dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_date_of_birth"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:hint="@string/input_date_of_birth"
                            android:inputType="date"
                            android:focusableInTouchMode="false"
                            />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- §6.5 S3 (D75) pane-order item (2) — handoff block:
                         the "Paste link" button (not a bare always-visible
                         field), and the area it reveals (the D69
                         cross-device QR hint + the existing manual-paste
                         field, the fallback-of-the-fallback). Primary path
                         is still av:// + direct_post, handled by
                         RegularActivity's VIEW intent-filter with no UI of
                         its own — this block is only the fallback.
                         Device fix (2026-09-05, "paste is taking too much
                         space with a button"): ONE compact row — a small
                         borderless/text-style button, no heading, no
                         card/box; the locked/read-in-progress dimmed hint
                         REPLACES the button's own text (MainActivity
                         .applySessionDisplay) rather than adding a second
                         line — see button_paste_link below, paste_disabled_
                         hint removed as its own view. maxLines/ellipsize
                         keep this ONE row's height fixed regardless of
                         which of the two texts (the short label or the
                         longer hint) is showing. -->
                    <LinearLayout
                        android:id="@+id/handoff_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/button_paste_link"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:minHeight="0dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:textSize="13sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="@string/button_paste_link" />

                        <!-- Device fix (2026-09-05, "text note and text box
                             is too big"): ONE row — the field alone. Apply
                             happens on the MAIN Scan/Verify button (owner
                             correction — MainActivity.onLockButtonTapped's
                             doc). The D69 cross-device QR hint sentence
                             (that USED to render here) moved into the About
                             dialog (MainActivity.showAboutDialog) instead
                             of taking a permanent second line of this
                             already-optional reveal area. -->
                        <LinearLayout
                            android:id="@+id/paste_reveal_area"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/handoff_manual_layout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                app:hintTextAppearance="@style/TextAppearance.AppCompat.Small">

                                <!-- Device fix (2026-09-05, "pasting link
                                     doesn't work"): textUri + actionDone +
                                     singleLine so the keyboard offers a
                                     reliable Done/checkmark action (a
                                     convenience trigger); the PRIMARY apply
                                     trigger is the main Scan/Verify button
                                     once this field holds text (owner
                                     correction — MainActivity
                                     .onLockButtonTapped). 13sp hint text,
                                     compact height (2026-09-05 round 3). -->
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/handoff_manual_input"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:minHeight="0dp"
                                    android:hint="@string/handoff_manual_hint"
                                    android:textSize="13sp"
                                    android:inputType="textUri"
                                    android:imeOptions="actionDone"
                                    android:singleLine="true" />

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                        <!-- Device fix (2026-09-05, "bottom unmovable part
                             of log"): capped so a long verified-handoff
                             status line can shift what's below it by no
                             more than a fixed two-line amount, instead of
                             growing without bound. -->
                        <TextView
                            android:id="@+id/handoff_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="monospace"
                            android:textIsSelectable="true"
                            android:textSize="12sp"
                            android:maxLines="2"
                            android:ellipsize="end" />

                    </LinearLayout>

                    <!-- The single large VERIFY button (item 20's verb rule unchanged; MainActivity sets its text). -->
                    <Button
                        android:id="@+id/button_lock_and_scan"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginTop="@dimen/activity_vertical_margin"
                        android:text="@string/button_lock_and_scan"
                        android:textSize="18sp" />

                    <!-- D115: the always-visible last-scan strip directly under VERIFY. Text, colours and glyph come
                         from LastScanStatus via MainActivity.applyLastScanLine (the single writer). A polite live
                         region, bold, at least 48dp high; the glyph in the text means colour is never the only signal. -->
                    <TextView
                        android:id="@+id/last_scan_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:accessibilityLiveRegion="polite"
                        android:background="@drawable/last_scan_bg"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:textColor="@color/status_none_text"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Last scan: state.gov, over 18: true, delivered ✓" />

                    <TextView
                        android:id="@+id/button_about"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginBottom="@dimen/activity_vertical_margin"
                        android:minHeight="48dp"
                        android:text="@string/button_about" />

                </LinearLayout>

        </ScrollView>

        <!-- §6.2 item 16 (D44) — the log tab: an additional CONSUMER of the
             same value-free content emitReport() already writes to ReportLog
             (MainActivity.emitReport), never a second write site. Hidden
             unless the "Log" tab is selected. FIX (owner, 2026-09-05):
             now the ONLY full-detail scan reader in the Scan/Log/Diagnostics
             set below report_view's removal — same value-free invariant as
             before, safe to screenshot. -->
        <ScrollView
            android:id="@+id/log_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- §6.2 item 23 (D70(b)) — empties the persisted, value-free
                     log (memory + disk); see MainActivity.clearLog(). -->
                <Button
                    android:id="@+id/button_clear_log"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:paddingLeft="@dimen/activity_horizontal_margin"
                    android:paddingRight="@dimen/activity_horizontal_margin"
                    android:text="@string/button_clear_log" />

                <TextView
                    android:id="@+id/log_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/activity_horizontal_margin"
                    android:paddingRight="@dimen/activity_horizontal_margin"
                    android:paddingTop="@dimen/activity_vertical_margin"
                    android:paddingBottom="@dimen/activity_vertical_margin"
                    android:fontFamily="monospace"
                    android:textIsSelectable="true"
                    android:textSize="12sp"
                    android:text="" />

            </LinearLayout>

        </ScrollView>

        <!-- M3b chunk 1 (item 7) / D115 — the Settings page: the holder's "Allow additional verifications" switch
             (OFF by default; text from TierCText, unit-tested; hidden with only the unavailable note when the build
             has tier C off), then Diagnostics as a COLLAPSED section at the bottom (the two probe buttons and their
             output, moved here from the old Diagnostics tab). -->
        <ScrollView
            android:id="@+id/settings_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="@dimen/activity_horizontal_margin"
                android:paddingRight="@dimen/activity_horizontal_margin"
                android:orientation="vertical">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_allow_additional"
                    android:saveEnabled="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:layout_marginBottom="@dimen/activity_vertical_margin" />

                <TextView
                    android:id="@+id/settings_help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/activity_vertical_margin"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/diagnostics_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="▸ Diagnostics" />

                <LinearLayout
                    android:id="@+id/diagnostics_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <Button
                    android:id="@+id/button_m2_masterlist_probe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:layout_marginBottom="@dimen/activity_vertical_margin"
                    android:text="@string/button_masterlist_probe" />

                <!-- Debug-only, zero-tap: exercises DeviceKey.ensureKey's
                     generate -> reuse path (twice, same process) without an
                     NFC session — see MainActivity's DeviceKey self-test
                     root-cause note. -->
                <Button
                    android:id="@+id/button_devicekey_probe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/activity_vertical_margin"
                    android:text="@string/button_devicekey_probe" />

                <!-- Device fix (2026-09-05, round 4, "yield nothing when
                     pressed") — both probes RAN (confirmed in logcat) but
                     their output had nowhere to show on THIS tab: it went
                     only to the Log tab. This is a SECOND PROJECTION TARGET
                     of the same reportLog.lastText MainActivity.applyReportText
                     writes here — never a second writer of the Diagnostics
                     report. Same value-free rules as log_view: verdict, step
                     names, counts, hashes, timings only. -->
                <TextView
                    android:id="@+id/diagnostics_report_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/activity_vertical_margin"
                    android:fontFamily="monospace"
                    android:textIsSelectable="true"
                    android:textSize="12sp"
                    android:text="" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <FrameLayout
            android:id="@+id/bottom_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom" />

    </FrameLayout>

    <!-- D115: page dots. Decorative (hidden from accessibility): the title already names the page. Drawn by
         MainActivity.showPane. -->
    <LinearLayout
        android:id="@+id/page_dots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="4dp" />

    <!-- §6.2 item 24 (D70(c)) — build stamp footer: versionName + short git
         sha of the commit the running build was compiled from. Set from
         MainActivity.onCreate via VersionStamp.format(BuildConfig.VERSION_NAME,
         BuildConfig.GIT_SHA); text-only, no click target, present regardless
         of which tab (Scan/Log) is selected. -->
    <TextView
        android:id="@+id/version_stamp_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:clickable="false"
        android:focusable="false"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="10sp"
        tools:text="v0.2.0 (abc1234)" />

</LinearLayout>
