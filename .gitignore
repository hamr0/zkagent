# Local agent/tool state — machine-specific, not project content
.claude/settings.local.json
.barebrowse/
.litectx/

# Real passport-derived material must never enter the tree (NO-GO #9).
# M0 test vectors built from a real chip contain MRZ data (name, DOB,
# document number). Keep them local; commit only synthetic/ICAO-sample vectors.
fixtures/real/
*.mrz
*.dg1
*.sod
secrets/

# Build / runtime
node_modules/
dist/
build/
*.log
.env

# apps/demo's persistent JSON store (§6.3 item 2/9) — operator-local runtime
# state (nonces, attester-key bindings, zktags-seen), never committed.
apps/demo/data/
.env.*
!.env.example

# Generated .d.ts (LIBRARY_CONVENTIONS §2: built on publish, never committed)
/packages/chiproof/types/

# Editor / OS
.idea/
.vscode/
.DS_Store
*~

# docs-builder machine state — regenerated every run; ledger stamp is per-clone
/docs/.docs-builder/

# M0 spike — local toolchain state and any real-chip capture
spikes/*/local.properties
spikes/*/.gradle/
captures/
*.dg14
*.dg15
spikes/m1-attest/fixtures/real/
spikes/m1-integrity/fixtures/real/
spikes/m1-zk/fixtures/real/
spikes/m1-zk/vendor/
spikes/m1-zk/out/
spikes/m1-zk/run/node_modules/
spikes/m1-zk/phone/dl/

# Transient friction analysis — regenerated every /remember run, cross-project content
/.claude/remember/friction/

# /branch-review working artifacts — private, regenerated every run, not deliverables.
# Narrow exception to the LIBRARY_CONVENTIONS §7 rule that keeps .claude/remember
# tracked: these two are rewritten by every review, so tracking them makes each
# review invalidate itself (the commit moves HEAD past the SHA it just recorded,
# which /release reads as stale). Project memory in .claude/remember stays tracked.
/.claude/remember/last-review.md
/.claude/remember/fix-ledger.md
